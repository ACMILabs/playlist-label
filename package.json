{
  "name": "playlistlabel",
  "version": "1.0.0",
  "description": "",
  "main": "''",
  "scripts": {
    "test": "jest",
    "test:debug": "node --inspect-brk=0.0.0.0:9229 node_modules/jest/bin/jest.js",
    "lint": "eslint . --ext .js,.mjs",
    "lint-test": "npm run lint && npm run test"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "jest-fetch-mock": "*"
  },
  "jest": {
    "cacheDirectory": "/tmp/jest_0",
    "testPathIgnorePatterns": [
      "/node_modules/"
    ],
    "automock": false,
    "transform": {
      "\\.m?js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^nanostores$": "<rootDir>/app/static/lifelike/vendor/nanostores.mjs",
      "^nanotags$": "<rootDir>/app/static/lifelike/vendor/nanotags.mjs"
    },
    "setupFiles": [
      "./setupJest.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ACMILabs/playlist-label-pi.git"
  },
  "author": "ACMILabs",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ACMILabs/playlist-label-pi/issues"
  },
  "homepage": "https://github.com/ACMILabs/playlist-label-pi#readme",
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "babel-eslint": "*",
    "babel-jest": "^30.5.2",
    "eslint": "*",
    "eslint-config-airbnb": "*",
    "eslint-config-prettier": "*",
    "eslint-config-react-app": "*",
    "eslint-plugin-flowtype": "*",
    "eslint-plugin-import": "*",
    "eslint-plugin-jest": "*",
    "eslint-plugin-jsx-a11y": "*",
    "eslint-plugin-prettier": "*",
    "eslint-plugin-react": "*",
    "jest-environment-jsdom": "^30.5.2",
    "moment": "*",
    "prettier": "*"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-transform-modules-commonjs"
    ]
  }
}
